# Server
DOCFUSION_HOST=127.0.0.1
DOCFUSION_PORT=8000

# Pipeline
UPLOAD_BATCH_WORKERS=4
TASK_RECOVERY_STALE_SECONDS=5

# LLM extraction
# Leave EXTRACT_API_KEY empty to use the built-in fallback extraction path.
EXTRACT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXTRACT_MODEL=qwen-plus
EXTRACT_API_KEY=sk-640a6d0c77a6454286e029fe74d8a47b

# Keep embedding downloads disabled by default.
EXTRACT_ENABLE_FIELD_MATCH_EMBEDDING=0
MATCHER_ENABLE_EMBEDDING=0
MATCHER_MODEL=shibing624/text2vec-base-chinese
